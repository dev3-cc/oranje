// Esquema único del monolito modular — D-01.
// Un esquema de Postgres por módulo de negocio; los diez en inglés (D-11).
//
// Convenciones que este archivo respeta (Estándares de Base de Datos):
//   §2  tabla snake_case SINGULAR, calificada por esquema
//   §3  uuid v7 para el id, text para texto libre, timestamptz para instantes
//   §4  sin DEFAULT en la PK: el uuid v7 lo genera la aplicación.
//       updated_at lo mantiene un TRIGGER, no la aplicación -> sin @updatedAt
//   §5  los semáforos son tablas de catálogo, nunca enums nativos
//
// Prisma 7: la url de conexión vive en prisma.config.ts, no aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "personal", "commercial", "demand", "coverage", "operations", "settlement", "supervision", "journal", "notifications", "catalogs"]
}

// ============================================================================
// catalogs — los 7 semáforos como datos, y los catálogos del vault
// ============================================================================

/// Los 7 semáforos. Uno de ellos es ONBOARDING, el de Ventas.
model StatusLight {
  id          String  @db.Uuid
  code        String  @unique @db.Text
  name        String  @db.Text
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  states       StatusLightState[] @relation("lightStates")
  statesByCode StatusLightState[] @relation("lightStatesByCode")
  reasons      StatusChangeReason[]
  transitions StatusLightTransition[]

  @@id([id])
  @@map("status_light")
  @@schema("catalogs")
}

/// Los estados de cada semáforo. Añadir un estado es un INSERT, no un despliegue.
/// El `code` va en inglés y el `name` en español (D-11).
model StatusLightState {
  id            String  @db.Uuid
  statusLightId String  @map("status_light_id") @db.Uuid
  /// El code del semaforo, desnormalizado desde status_light. Es lo que permite
  /// FIJAR a que semaforo pertenece una fila con un CHECK: contra el uuid no se
  /// puede, porque el uuid v7 lo genera el seed y cambia en cada ambiente.
  /// 'WORKER' es 'WORKER' en todas partes. FK con ON UPDATE CASCADE.
  statusLightCode String @map("status_light_code") @db.Text
  code          String  @db.Text
  color         String  @db.Text
  name          String  @db.Text
  description   String? @db.Text
  displayOrder  Int     @map("display_order")
  /// Marca los estados que son rama y no paso del avance normal.
  /// En Onboarding: RED, BROWN y BLACK.
  isBranch      Boolean @default(false) @map("is_branch")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  statusLight       StatusLight              @relation("lightStates", fields: [statusLightId], references: [id], onDelete: Restrict)
  statusLightByCode StatusLight              @relation("lightStatesByCode", fields: [statusLightCode], references: [code], onDelete: Restrict)
  transitionsFrom   StatusLightTransition[]  @relation("fromState")
  transitionsTo     StatusLightTransition[]  @relation("toState")
  prospects           Prospect[]
  historyFrom         ProspectStateHistory[]      @relation("histFrom")
  historyTo           ProspectStateHistory[]      @relation("histTo")
  requisitions        Requisition[]
  positionsCoverage   Position[]                  @relation("posCoverage")
  positionsUrgency    Position[]                  @relation("posUrgency")
  reqHistoryFrom      RequisitionStateHistory[]   @relation("reqHistFrom")
  reqHistoryTo        RequisitionStateHistory[]   @relation("reqHistTo")
  workers            Worker[]             @relation("workerState")
  workerHistoryFrom  WorkerStateHistory[] @relation("workerHistFrom")
  workerHistoryTo    WorkerStateHistory[] @relation("workerHistTo")

  @@id([id])
  /// Un color significa una cosa POR semáforo: el code es único dentro de su semáforo.
  @@unique([statusLightId, code], map: "ux_status_light_state_light_code")
  /// Sostiene la FK compuesta que impide que una entidad tome el estado de otro
  /// semáforo. Ver restricción 2 del diagrama de Ventas.
  @@unique([id, statusLightId], map: "ux_status_light_state_id_light")
  /// De aqui cuelgan las FK compuestas que SI fijan el semaforo.
  @@unique([id, statusLightCode], map: "ux_status_light_state_id_code")
  @@index([statusLightId], map: "ix_status_light_state_light")
  @@map("status_light_state")
  @@schema("catalogs")
}

/// Tabla puente N:M auto-referencial CON atributos: qué movimientos son legales,
/// quién puede hacerlos y qué se le exige. Las 13 RF de Ventas colapsan en un
/// solo servicio que lee de aquí.
model StatusLightTransition {
  id String @db.Uuid
  /// El semaforo al que pertenece el paso. Una sola columna sirve a las DOS
  /// llaves compuestas, y por eso el origen y el destino no pueden ser de
  /// semaforos distintos: los dos se comparan contra este mismo valor.
  ///
  /// Sin esto las FK eran simples y nada impedia un paso que saliera de un estado
  /// del Onboarding y llegara a uno del Colaborador. Mismo patron que ya usan
  /// requisition y position (D-19).
  statusLightId String @map("status_light_id") @db.Uuid

  fromStateId String  @map("from_state_id") @db.Uuid
  /// NULO cuando returns_to_previous es true: el destino no se conoce hasta que
  /// se lee la historia del semaforo. Un CHECK garantiza que exactamente una de
  /// las dos formas este presente.
  toStateId   String? @map("to_state_id") @db.Uuid
  /// El destino es "el estado previo", no un estado fijo. El Semaforo del
  /// Colaborador tiene dos asi: Morado -> estado previo (vuelve a ponchar) y
  /// Cafe -> estado previo (vence o se cancela la asignacion temporal). Cual sea
  /// depende de donde venia, asi que el servicio lo saca del ultimo renglon de
  /// la tabla de historia — que existe justo para esto (D-14).
  returnsToPrevious Boolean @default(false) @map("returns_to_previous")

  authorizedRoleId String  @map("authorized_role_id") @db.Uuid
  requiresReason   Boolean @default(false) @map("requires_reason")
  requiresEvidence Boolean @default(false) @map("requires_evidence")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  statusLight StatusLight @relation(fields: [statusLightId], references: [id], onDelete: Restrict)
  /// Las dos apuntan a (id, status_light_id). La del destino es nulable, y con
  /// MATCH SIMPLE —el default de Postgres— una llave compuesta con una parte NULL
  /// no se verifica: justo lo que hace falta cuando returns_to_previous es true y
  /// no hay destino que validar.
  fromState      StatusLightState  @relation("fromState", fields: [fromStateId, statusLightId], references: [id, statusLightId], onDelete: Restrict)
  toState        StatusLightState? @relation("toState", fields: [toStateId, statusLightId], references: [id, statusLightId], onDelete: Restrict)
  authorizedRole Role              @relation(fields: [authorizedRoleId], references: [id], onDelete: Restrict)

  /// Si dos roles pueden hacer el mismo paso, son dos filas.
  ///
  /// OJO: en la base este indice lleva NULLS NOT DISTINCT, que Prisma no sabe
  /// declarar. Sin esa clausula los NULL de to_state_id serian distintos entre
  /// si y dos filas (from, NULL, role) pasarian las dos. Se declara aqui igual
  /// —mismo nombre, mismas columnas— para que Prisma lo reconozca como suyo y
  /// no lo borre en el siguiente diff, que es como se perdio el indice espacial
  /// de la geocerca el 2026-08-08. Si alguna vez se regenera sin la clausula,
  /// hay que volver a aplicarla a mano.
  @@id([id])
  @@unique([fromStateId, toStateId, authorizedRoleId], map: "ux_status_light_transition_step")
  @@index([statusLightId], map: "ix_status_light_transition_light")
  @@index([fromStateId], map: "ix_status_light_transition_from")
  @@index([toStateId], map: "ix_status_light_transition_to")
  @@index([authorizedRoleId], map: "ix_status_light_transition_role")
  @@map("status_light_transition")
  @@schema("catalogs")
}

/// Los motivos catalogados de un cambio de estado. Sin esto, el reporte de
/// rechazos no se puede agrupar (09 - Dependencias de Ventas).
model StatusChangeReason {
  id            String @db.Uuid
  statusLightId String @map("status_light_id") @db.Uuid
  code          String @db.Text
  name          String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  statusLight     StatusLight            @relation(fields: [statusLightId], references: [id], onDelete: Restrict)
  prospectCloses     Prospect[]
  historyEntries     ProspectStateHistory[]
  reqHistoryEntries  RequisitionStateHistory[]
  workerStateChanges WorkerStateHistory[]

  @@id([id])
  @@unique([statusLightId, code], map: "ux_status_change_reason_light_code")
  @@index([statusLightId], map: "ix_status_change_reason_light")
  @@map("status_change_reason")
  @@schema("catalogs")
}

/// Agrupa hoteles para asignar Inspector (RR-13). No es la geocerca.
model Zone {
  id   String @db.Uuid
  code String @unique @db.Text
  name String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  hotels    Hotel[]
  userZones UserZone[]
  workers Worker[]

  @@id([id])
  @@map("zone")
  @@schema("catalogs")
}

/// Los departamentos internos del hotel para los que Oranje recluta.
/// Housekeeping · Alimentos · Mantenimiento · Front Desk
model HotelDepartment {
  id   String @db.Uuid
  code String @unique @db.Text
  name String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  users             User[]
  catalogPositions  CatalogPosition[]
  requestedPositions Position[]

  @@id([id])
  @@map("hotel_department")
  @@schema("catalogs")
}

// ============================================================================
// identity — usuarios, roles y permisos (Modelo de Datos §9)
//
// Autorizar tiene DOS preguntas y esta sección las separa:
//   la capacidad -> role_permission (la Matriz de Permisos, pura, por rol)
//   el alcance   -> user.hotel_id + user.department_id (un hecho de la persona)
// ============================================================================

/// Los roles del sistema, con el ID del vault: ROL-V-01, ROL-H-02, etc.
/// NO es el puesto del contacto del hotel.
model Role {
  id         String  @db.Uuid
  code       String  @unique @db.Text
  name       String  @db.Text
  department String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  users                 User[]
  permissions           RolePermission[]
  authorizedTransitions StatusLightTransition[]

  @@id([id])
  @@map("role")
  @@schema("identity")
}

/// La Matriz de Permisos como filas. Agregar un módulo es un INSERT, nunca una
/// migración de esquema.
///
/// Esta tabla NO lleva hotel_id: si lo llevara, la fila diría "el rol Manager de
/// Área aprueba horas en el Hotel Riu" y habría que insertar una fila por hotel,
/// por departamento y por acción. El alcance vive en la persona.
model RolePermission {
  id     String @db.Uuid
  roleId String @map("role_id") @db.Uuid
  module String @db.Text
  action String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([id])
  @@unique([roleId, module, action], map: "ux_role_permission_role_module_action")
  @@index([roleId], map: "ix_role_permission_role")
  @@map("role_permission")
  @@schema("identity")
}

/// El usuario del sistema, y el ALCANCE de su autoridad.
///
/// departmentId nulo NO significa "sin alcance": significa TODOS los
/// departamentos de mi hotel. Es lo que separa al Manager General del Manager de
/// Área sin una tabla de excepciones.
///
/// hotelId nulo es el caso de los roles de territorio — BD, BDC, Inspector —
/// cuyo alcance son zonas y vive en commercial.user_zone.
model User {
  id       String @db.Uuid
  email    String @unique @db.Text
  /// El uid de Firebase Auth, 28 caracteres, NO es un uuid. Es el puente: el token
  /// trae el uid, se busca aqui, y de ahi en adelante todo usa NUESTRO id.
  /// Firebase guarda la contrasena; nosotros no guardamos ningun hash.
  /// Nulable porque el staff sembrado no tiene cuenta de Firebase todavia.
  firebaseUid String? @unique @map("firebase_uid") @db.Text
  fullName String @map("full_name") @db.Text
  roleId   String @map("role_id") @db.Uuid

  /// Alcance: el hotel al que pertenece. Nulo en roles de territorio.
  hotelId      String? @map("hotel_id") @db.Uuid
  /// Alcance: su departamento dentro del hotel. NULO = todos los del hotel.
  departmentId String? @map("department_id") @db.Uuid

  /// El BD apunta a su BDC; la Reclutadora a su Líder de Grupo.
  /// La punta de la jerarquía no le reporta a nadie.
  reportsToUserId String? @map("reports_to_user_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  hotel      Hotel?           @relation("hotelUsers", fields: [hotelId], references: [id], onDelete: Restrict)
  department HotelDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportsTo  User?            @relation("jerarquia", fields: [reportsToUserId], references: [id], onDelete: Restrict)
  reports    User[]           @relation("jerarquia")

  hotelsCreated  Hotel[]                @relation("hotelCreatedBy")
  hotelsUpdated  Hotel[]                @relation("hotelUpdatedBy")
  prospectsOwned Prospect[]             @relation("prospectOwner")
  attempts       ContactAttempt[]
  stateChanges   ProspectStateHistory[]
  proposalsSent  Proposal[]
  zones          UserZone[]

  requisitionsCreated    Requisition[]             @relation("reqCreatedBy")
  requisitionsUpdated    Requisition[]             @relation("reqUpdatedBy")
  requisitionsAsManager  Requisition[]             @relation("reqAreaManager")
  requisitionsAuthorized Requisition[]             @relation("reqAuthorizedBy")
  requisitionsAsInspector Requisition[]            @relation("reqInspector")
  requisitionStateChanges RequisitionStateHistory[]
  journalEntries          JournalEntry[]

  worker              Worker?               @relation("workerAccount")
  workersCreated      Worker[]              @relation("workerCreatedBy")
  documentsVerified   WorkerDocument[]
  workerStateChanges  WorkerStateHistory[]
  assignmentsMade     Assignment[]
  participations      Participation[]
  blacklistEntered    BlacklistEntry[]      @relation("blacklistEnteredBy")
  blacklistLifted     BlacklistEntry[]      @relation("blacklistLiftedBy")
  refreshTokens       RefreshToken[]

  @@id([id])
  @@index([roleId], map: "ix_user_role")
  @@index([hotelId], map: "ix_user_hotel")
  @@index([reportsToUserId], map: "ix_user_reports_to")
  @@map("user")
  @@schema("identity")
}

/// Una sesión viva. El access token es de 15 minutos y no se guarda en ningún
/// lado; esta tabla existe para poder MATAR una sesión antes de que expire su
/// refresh, que dura 7 días (Estándares de Desarrollo §6).
///
/// Firebase autentica; este token es nuestro y es el que protege los CRUD.
model RefreshToken {
  id     String @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 del token, nunca el token. Si se filtra la tabla, lo que se filtra
  /// no sirve para entrar.
  tokenHash String @unique @map("token_hash") @db.Text

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Cada refresh emite uno nuevo y apunta al anterior. Si llega un token ya
  /// reemplazado, es reuso: alguien tiene una copia y se revoca la cadena.
  replacedById String? @unique @map("replaced_by_id") @db.Uuid

  /// Para que el usuario reconozca la sesión que va a cerrar.
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("rotacion", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("rotacion")

  @@id([id])
  @@index([userId], map: "ix_refresh_token_user")
  @@index([expiresAt], map: "ix_refresh_token_expires")
  @@map("refresh_token")
  @@schema("identity")
}

// ============================================================================
// commercial — solo `hotel`, que identity.user necesita por FK.
// Las otras 6 tablas del diagrama v2 llegan en la siguiente migración.
// ============================================================================

/// SOLO lo permanente del edificio. Sin estado de semáforo —vive en prospect— y
/// sin columnas de contacto —viven en hotel_contact (D-13).
model Hotel {
  id           String  @db.Uuid
  name         String  @db.Text
  generalPhone String? @map("general_phone") @db.Text
  zoneId       String  @map("zone_id") @db.Uuid

  /// PostGIS. Prisma no tipa geography: las consultas de geocerca van en SQL
  /// crudo con ST_DWithin, que es donde deben estar (D-08).
  coordinates      Unsupported("public.geography(Point, 4326)")?
  geofenceRadiusM  Int?                                  @map("geofence_radius_m")

  /// IANA, no offset numérico: un offset no sabe de horario de verano.
  /// Sin esto no se puede calcular la jornada ni el corte semanal (§11).
  timeZone String @map("time_zone") @db.Text

  /// El único hecho de "es cliente" que se queda en el hotel. Con varios ciclos
  /// comerciales, ninguna otra tabla puede contestar desde cuándo lo es.
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  zone      Zone             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  users     User[]           @relation("hotelUsers")
  contacts     HotelContact[]
  prospects    Prospect[]
  attempts     ContactAttempt[]
  requisitions Requisition[]
  creator   User?  @relation("hotelCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?  @relation("hotelUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([zoneId], map: "ix_hotel_zone")
  @@index([coordinates(ops: raw("gist_geography_ops"))], map: "ix_hotel_coordinates", type: Gist)
  @@map("hotel")
  @@schema("commercial")
}

// ============================================================================
// commercial — el pipeline de Ventas. Las 6 tablas restantes del diagrama v2.
// ============================================================================

/// Los contactos del hotel. Son filas, no columnas de hotel: un hotel tiene al
/// de Compras y al de Ama de Llaves a la vez.
model HotelContact {
  id       String  @db.Uuid
  hotelId  String  @map("hotel_id") @db.Uuid
  fullName String  @map("full_name") @db.Text
  /// El puesto EN EL HOTEL, no un rol del sistema. Texto, no catalogo: nadie
  /// filtra por el todavia.
  jobTitle String? @map("job_title") @db.Text
  phone    String? @db.Text
  email    String? @db.Text
  /// Quien es el principal es una decision del BD, no el mas reciente.
  /// Un solo principal por hotel: UNIQUE parcial en la migracion.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  hotel    Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  attempts ContactAttempt[]

  @@id([id])
  /// Sostiene la FK compuesta de contact_attempt (restriccion 6).
  @@unique([id, hotelId], map: "ux_hotel_contact_id_hotel")
  @@index([hotelId], map: "ix_hotel_contact_hotel")
  @@map("hotel_contact")
  @@schema("commercial")
}

/// UN CICLO COMERCIAL de un hotel, y donde vive el Semaforo Onboarding (D-13).
/// Un hotel se prospecta mas de una vez: cada intento es una fila, y solo uno
/// puede estar abierto a la vez.
model Prospect {
  id              String  @db.Uuid
  hotelId         String  @map("hotel_id") @db.Uuid
  /// El BD dueno del ciclo, no del edificio: asi la tasa de conversion queda
  /// limpia cuando un prospecto se reasigna (RF-V-24).
  ownerUserId     String  @map("owner_user_id") @db.Uuid
  needDescription String? @map("need_description") @db.Text

  /// El estado del semaforo. La verdad esta en prospect_state_history; esta
  /// columna es el atajo al estado actual (D-14).
  onboardingStateId String @map("onboarding_state_id") @db.Uuid
  /// Redundante a proposito: sostiene la FK compuesta que impide que un
  /// prospecto tome un estado de OTRO semaforo. Fijado a ONBOARDING por CHECK.
  statusLightCode   String @map("status_light_code") @db.Text

  openedAt      DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReasonId String?   @map("close_reason_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  hotel           Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  owner           User                @relation("prospectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  onboardingState StatusLightState    @relation(fields: [onboardingStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  closeReason     StatusChangeReason? @relation(fields: [closeReasonId], references: [id], onDelete: Restrict)

  attempts ContactAttempt[]
  history  ProspectStateHistory[]
  proposals Proposal[]

  @@id([id])
  /// Sostiene la FK compuesta de contact_attempt (restriccion 6).
  @@unique([id, hotelId], map: "ux_prospect_id_hotel")
  @@index([onboardingStateId], map: "ix_prospect_state")
  @@index([ownerUserId, onboardingStateId], map: "ix_prospect_owner")
  @@index([hotelId], map: "ix_prospect_hotel")
  @@map("prospect")
  @@schema("commercial")
}

/// Una fila por cada cambio de color (D-14). Es la verdad del semaforo: sin
/// ella no hay tiempo-en-estado ni motivo de transicion fuera del cierre.
model ProspectStateHistory {
  id          String  @db.Uuid
  prospectId  String  @map("prospect_id") @db.Uuid
  /// Nulo en el primero: el prospecto nace en un estado, no viene de otro.
  fromStateId String? @map("from_state_id") @db.Uuid
  toStateId   String  @map("to_state_id") @db.Uuid
  /// Fijado a ONBOARDING por CHECK. Antes estas dos FK eran SIMPLES, asi que esta
  /// tabla ni siquiera impedia pares mal formados: podia registrar una
  /// transicion entre estados de dos semaforos distintos.
  statusLightCode String @map("status_light_code") @db.Text
  reasonId    String? @map("reason_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prospect  Prospect            @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  fromState StatusLightState?   @relation("histFrom", fields: [fromStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  toState   StatusLightState    @relation("histTo", fields: [toStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  reason    StatusChangeReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([prospectId, occurredAt(sort: Desc)], map: "ix_state_history_prospect")
  @@map("prospect_state_history")
  @@schema("commercial")
}

/// Cada intento de contacto. NO es una tabla intermedia: tiene hechos propios
/// —fecha, resultado, quien lo hizo— y puede haber cinco al mismo contacto.
model ContactAttempt {
  id         String  @db.Uuid
  prospectId String  @map("prospect_id") @db.Uuid
  /// Redundante: se deduce del prospecto. Existe para que las dos FK compuestas
  /// impidan citar el contacto de OTRO hotel (restriccion 6).
  hotelId    String  @map("hotel_id") @db.Uuid
  /// Opcional: una visita en frio puede no encontrar a nadie.
  hotelContactId String? @map("hotel_contact_id") @db.Uuid

  /// Listas cerradas con CHECK, no catalogos: no hay pantalla donde el negocio
  /// agregue un canal ni un resultado (restriccion 9).
  attemptType String @map("attempt_type") @db.Text
  outcome     String @db.Text

  userId     String   @map("user_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  notes      String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prospect     Prospect      @relation(fields: [prospectId, hotelId], references: [id, hotelId], onDelete: Restrict)
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  hotelContact HotelContact? @relation(fields: [hotelContactId, hotelId], references: [id, hotelId], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Sin columna attempt_count en prospect: es COUNT(*).
  @@id([id])
  @@index([prospectId, occurredAt(sort: Desc)], map: "ix_contact_attempt_prospect")
  @@index([hotelId], map: "ix_contact_attempt_hotel")
  @@map("contact_attempt")
  @@schema("commercial")
}

/// La Propuesta Personalizada. Se elabora y envia en GREEN (RR-V-09) y se
/// ajusta desde BROWN: una fila por version, para no perder lo ofrecido.
model Proposal {
  id           String  @db.Uuid
  prospectId   String  @map("prospect_id") @db.Uuid
  version      Int
  servicesNote String? @map("services_note") @db.Text

  /// Tarifas TENTATIVAS y globales. No pagan ni facturan nada: las que cuentan
  /// son las del Contrato. Cuando el negocio cotice por posicion, se agrega
  /// proposal_rate sin tocar esta tabla.
  payRate  Decimal? @map("pay_rate") @db.Decimal(10, 4)
  billRate Decimal? @map("bill_rate") @db.Decimal(10, 4)

  sentByUserId String?   @map("sent_by_user_id") @db.Uuid
  /// Nulo = borrador.
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  sentBy   User?    @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@id([id])
  @@unique([prospectId, version], map: "ux_proposal_prospect_version")
  @@map("proposal")
  @@schema("commercial")
}

/// Tabla puente N:M CON atributo. Es TERRITORIO, no propiedad del prospecto:
/// esa vive en prospect.owner_user_id. Un BD cubre varias zonas y una zona
/// puede tener varios BD.
model UserZone {
  userId     String   @map("user_id") @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@id([userId, zoneId])
  @@index([zoneId], map: "ix_user_zone_zone")
  @@map("user_zone")
  @@schema("commercial")
}

// ============================================================================
// catalogs — los tres que vuelven, ahora que la Posicion solicitada los usa.
// Se habian quitado en `quita_catalogos_fuera_del_esquema` por no tener
// consumidor. Fuente: Core/Catalogos/ del vault.
// ============================================================================

/// Housekeeper, Houseman, Chef… Agrupada por departamento del hotel.
/// La lista NO es exhaustiva: el negocio agrega posiciones sin avisar, y por eso
/// es tabla y no un CHECK (Estandares de BD seccion 5).
///
/// OJO: no confundir con demand.position. Esta es el CATALOGO de puestos; la
/// otra es una posicion SOLICITADA en una requisicion.
model CatalogPosition {
  id                String @db.Uuid
  hotelDepartmentId String @map("hotel_department_id") @db.Uuid
  code              String @unique @db.Text
  name              String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  hotelDepartment    HotelDepartment @relation(fields: [hotelDepartmentId], references: [id], onDelete: Restrict)
  requestedPositions Position[]
  workers Worker[]

  @@id([id])
  @@index([hotelDepartmentId], map: "ix_position_hotel_department")
  @@map("position")
  @@schema("catalogs")
}

/// Tiempo completo · Medio tiempo · Temporal · Segun solicitud
model HiringModality {
  id   String @db.Uuid
  code String @unique @db.Text
  name String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  positions Position[]
  workers Worker[]

  @@id([id])
  @@map("hiring_modality")
  @@schema("catalogs")
}

/// Basico · Intermedio · Avanzado · Conversacional.
/// displayOrder permite preguntar "nivel mayor o igual a Intermedio".
model EnglishLevel {
  id           String @db.Uuid
  code         String @unique @db.Text
  name         String @db.Text
  displayOrder Int    @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  positions Position[]
  workers Worker[]

  @@id([id])
  @@map("english_level")
  @@schema("catalogs")
}

// ============================================================================
// demand — la Requisicion, sus Posiciones y el Slot.
// Fuente: Hotel/Demanda - Modelo de Datos.drawio
// ============================================================================

/// La cabecera de la requisicion. Los reclutadores NO estan aqui: son varios a
/// la vez y viven en coverage.participation (RR-15).
model Requisition {
  id     String @db.Uuid
  /// AAAAMMDDHHMM + homoclave de 2 caracteres.
  number String @unique @db.Text

  hotelId String @map("hotel_id") @db.Uuid

  /// Semaforo de Requisicion: Verde manzana · Verde · Amarillo · Azul claro ·
  /// Rojo · Morado. statusLightId es redundante a proposito: sostiene la FK
  /// compuesta que impide tomar un estado de otro semaforo.
  statusLightStateId String @map("status_light_state_id") @db.Uuid
  statusLightCode    String @map("status_light_code") @db.Text

  /// El GH responsable del departamento. Puede NO ser quien autoriza: un Manager
  /// General puede autorizar la requisicion de un departamento cuyo GH es otro.
  /// Pendiente de confirmar con el negocio.
  areaManagerUserId String? @map("area_manager_user_id") @db.Uuid

  authorizedBy String?   @map("authorized_by") @db.Uuid
  authorizedAt DateTime? @map("authorized_at") @db.Timestamptz(6)

  /// El Inspector de la zona del hotel, asignado automaticamente (RR-13).
  inspectorId String? @map("inspector_id") @db.Uuid

  /// Borrado logico. El estado Morado del semaforo lo exige: una fila borrada
  /// fisicamente no puede tener un estado.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  /// El Supervisor que la creo.
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  statusState StatusLightState @relation(fields: [statusLightStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  areaManager User?            @relation("reqAreaManager", fields: [areaManagerUserId], references: [id], onDelete: Restrict)
  authorizer  User?            @relation("reqAuthorizedBy", fields: [authorizedBy], references: [id], onDelete: Restrict)
  inspector   User?            @relation("reqInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  creator     User?            @relation("reqCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User?            @relation("reqUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  positions Position[]
  history   RequisitionStateHistory[]
  participations Participation[]

  @@id([id])
  @@index([hotelId, statusLightStateId], map: "ix_requisition_hotel_state")
  @@index([inspectorId], map: "ix_requisition_inspector")
  @@map("requisition")
  @@schema("demand")
}

/// Una posicion solicitada dentro de la requisicion. Carga DOS semaforos: el de
/// Posiciones (cobertura) y el de Urgencia.
model Position {
  id            String @db.Uuid
  requisitionId String @map("requisition_id") @db.Uuid
  /// El renglon dentro de la requisicion, como una partida de factura.
  lineNumber    Int    @map("line_number")

  catalogPositionId String  @map("catalog_position_id") @db.Uuid
  hiringModalityId  String  @map("hiring_modality_id") @db.Uuid
  /// Es PREFERENCIA del hotel, no requisito: por eso es opcional.
  englishLevelId    String? @map("english_level_id") @db.Uuid
  /// El departamento de la posicion SOLICITADA. No se deriva del catalogo: el
  /// hotel puede pedir un Housekeeper para Alimentos.
  hotelDepartmentId String  @map("hotel_department_id") @db.Uuid

  quantity Int
  /// Sin fecha de fin a proposito: la posicion termina cuando el Manager de Area
  /// manda al colaborador a descansar (Rosa - Stand-by).
  startDate DateTime @map("start_date") @db.Date
  /// Solo la hora de entrada. La duracion del turno se decide al disenar
  /// operations: es el Schedule quien la necesita.
  startTime DateTime? @map("start_time") @db.Time(0)
  notes     String?   @db.Text

  /// Semaforo de Posiciones: Dorado · Naranja · Verde · Amarillo · Rojo · Morado.
  /// Derivado de contar slots ocupados; se guarda porque el tablero lo filtra.
  coverageStateId String @map("coverage_state_id") @db.Uuid
  coverageLightCode String @map("coverage_light_code") @db.Text

  /// Semaforo de Urgencia: Rojo (<72h) · Amarillo (72-120h) · Verde fuerte (>120h).
  /// Derivado de authorized_at contra start_date (RR-H-05); lo recalcula un job.
  urgencyStateId String? @map("urgency_state_id") @db.Uuid
  urgencyLightCode String? @map("urgency_light_code") @db.Text

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  requisition     Requisition       @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  catalogPosition CatalogPosition   @relation(fields: [catalogPositionId], references: [id], onDelete: Restrict)
  hiringModality  HiringModality    @relation(fields: [hiringModalityId], references: [id], onDelete: Restrict)
  englishLevel    EnglishLevel?     @relation(fields: [englishLevelId], references: [id], onDelete: Restrict)
  hotelDepartment HotelDepartment   @relation(fields: [hotelDepartmentId], references: [id], onDelete: Restrict)
  coverageState   StatusLightState  @relation("posCoverage", fields: [coverageStateId, coverageLightCode], references: [id, statusLightCode], onDelete: Restrict)
  urgencyState    StatusLightState? @relation("posUrgency", fields: [urgencyStateId, urgencyLightCode], references: [id, statusLightCode], onDelete: Restrict)

  slots Slot[]

  @@id([id])
  @@index([requisitionId], map: "ix_position_requisition")
  @@index([urgencyStateId], map: "ix_position_urgency")
  @@map("position")
  @@schema("demand")
}

/// LA UNIDAD DE BLOQUEO. Una fila por cada persona solicitada: quantity = 3
/// genera 3 slots. Es lo que permite cumplir RR-15 sin Redis — se bloquea la
/// fila del slot, no la requisicion (D-02).
///
/// Sin deletedAt a proposito: si quantity baja, el slot libre se borra
/// fisicamente y el ocupado no se puede borrar (FK de coverage.assignment).
model Slot {
  id         String @db.Uuid
  positionId String @map("position_id") @db.Uuid
  /// El enesimo slot de su posicion. El ORDER BY del Self-Pick lo usa para que
  /// se ocupen en orden determinista.
  ordinal    Int
  /// Lista cerrada y tecnica: el negocio no agrega estados de ocupacion.
  /// Va como CHECK, no como catalogo (seccion 5).
  status     String @default("free") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  assignments Assignment[]

  @@id([id])
  @@unique([positionId, ordinal], map: "ux_slot_position_ordinal")
  @@map("slot")
  @@schema("demand")
}

/// El timeline inmutable de la cabecera. La nota de Requisicion pide un
/// "timeline cronologico inmutable con actor y timestamp". Es D-14 aplicado.
/// Append-only: sin updated_at ni deleted_at (Estandares de BD seccion 4).
model RequisitionStateHistory {
  id            String   @db.Uuid
  requisitionId String   @map("requisition_id") @db.Uuid
  /// Nulo en el primero: la requisicion nace en un estado, no viene de otro.
  fromStateId   String?  @map("from_state_id") @db.Uuid
  toStateId     String   @map("to_state_id") @db.Uuid
  /// Fijado a REQUISITION por CHECK. Antes estas dos FK eran SIMPLES, asi que esta
  /// tabla ni siquiera impedia pares mal formados: podia registrar una
  /// transicion entre estados de dos semaforos distintos.
  statusLightCode String @map("status_light_code") @db.Text
  reasonId      String?  @map("reason_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  requisition Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  fromState   StatusLightState?   @relation("reqHistFrom", fields: [fromStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  toState     StatusLightState    @relation("reqHistTo", fields: [toStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  reason      StatusChangeReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([requisitionId, occurredAt(sort: Desc)], map: "ix_requisition_history")
  @@map("requisition_state_history")
  @@schema("demand")
}
// ============================================================================
// journal — la bitácora inmutable. RR-16.
// Fuente: _Globales/Journal - Modelo de Datos.drawio
//
// OJO: esta tabla está PARTICIONADA POR MES, y Prisma no expresa particionado.
// El `PARTITION BY RANGE` y las particiones se crean en SQL a mano dentro de la
// migración. El modelo existe aquí para que `migrate diff` la vea y no la
// intente borrar — el particionado le es invisible.
// ============================================================================

/// Append-only. Sin updated_at, updated_by ni deleted_at: es la excepción de la
/// sección 4 de Estándares de Base de Datos. occurred_at hace de created_at,
/// porque en una tabla append-only son el mismo instante.
model JournalEntry {
  id String @db.Uuid

  /// Vínculo POLIMÓRFICO, sin FK a propósito: con una columna por tabla serían
  /// 23 nulables, y con ON DELETE CASCADE borrar una fila borraría su propia
  /// auditoría. El costo asumido es que nada valida que entity_id exista.
  entityType String @map("entity_type") @db.Text
  entityId   String @map("entity_id") @db.Uuid

  /// Lista ABIERTA, va como text: TOOK, JOINED, LEFT, STATUS_CHANGED,
  /// ASSIGNED_WORKER, REASSIGNED. Un CHECK obligaria a una migracion por evento.
  eventType String @map("event_type") @db.Text

  /// La unica FK del journal: quien actuo si se valida.
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorRole   String? @map("actor_role") @db.Text

  /// Solo para el payload del journal (seccion 3). NO se indexa.
  payload Json? @db.JsonB

  /// La llave de particion. Postgres exige que este en la PK.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "ix_journal_entity")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "ix_journal_actor")
  @@index([eventType, occurredAt(sort: Desc)], map: "ix_journal_event")
  @@map("journal")
  @@schema("journal")
}

// ============================================================================
// personal — quien es la persona
//
// Esquema propio y no parte de coverage, por PERMISOS: el expediente lleva SSN e
// ITIN, que necesitan cifrado de campo con la llave en Secret Manager. Un esquema
// aparte es un solo GRANT en vez de permisos columna por columna. Y el criterio
// del corte: la persona sobrevive a todas sus asignaciones.
// ============================================================================

/// El Colaborador. La entidad central del sistema.
///
/// Casi todo es nulable, y no es descuido: los datos llegan en TRES fases. La
/// Reclutadora captura la Fase 1 en la entrevista, y el propio colaborador llena
/// las Fases 2 y 3 despues, desde la app. Entre una y otra la fila existe a
/// medias — y eso ES el estado Blanco. "Obligatorio" en 10 - Validaciones es
/// regla del FORMULARIO, no de la columna; la del negocio es el guard de la
/// transicion Blanco -> Verde fuerte, que lee is_profile_complete.
model Worker {
  id String @db.Uuid
  /// La cuenta con la que entra a la app. Nulable porque la Reclutadora puede
  /// capturar la Fase 1 antes de que exista la cuenta de Firebase.
  userId String? @unique(map: "ux_worker_user") @map("user_id") @db.Uuid

  // --- Fase 1: la captura la Reclutadora en la entrevista ---
  fullName String @map("full_name") @db.Text
  /// NO se guarda la edad, que Colaborador.md pide: un dato que se vuelve falso
  /// solo. En 12 meses toda la tabla mentiria. La edad se calcula al leer.
  birthDate DateTime @map("birth_date") @db.Date
  gender    String   @db.Text
  phone     String   @db.Text
  address   String   @db.Text
  /// La asigna la Reclutadora. Se guarda en vez de derivarla del domicilio
  /// porque derivarla exige geocodificar, y el Pool filtra por zona siempre.
  zoneId String @map("zone_id") @db.Uuid

  // --- Fase 2: la llena el propio Colaborador ---
  /// Cifrados con pgcrypto, llave en Secret Manager. Los dos OPCIONALES: sin
  /// ninguno se activa la retencion del 16% (ver has_tax_id).
  ///
  /// PRECIO DEL CIFRADO: 10 - Validaciones exige formato XXX-XX-XXXX para el SSN
  /// y 9XX-XX-XXXX para el ITIN, y sobre un bytea cifrado no se puede escribir
  /// ese CHECK. Esas dos validaciones se quedan en Zod: la unica excepcion
  /// consciente al principio de "la regla vive en la base".
  ssnEncrypted  Bytes? @map("ssn_encrypted")
  itinEncrypted Bytes? @map("itin_encrypted")

  catalogPositionId String? @map("catalog_position_id") @db.Uuid
  englishLevelId    String? @map("english_level_id") @db.Uuid
  hiringModalityId  String? @map("hiring_modality_id") @db.Uuid
  /// Listas CERRADAS de 09 - Campos del Formulario: el negocio no agrega
  /// opciones de experiencia ni tipos de transporte. Van como text + CHECK, no
  /// como catalogo (seccion 5).
  experienceLevel String? @map("experience_level") @db.Text
  transportType   String? @map("transport_type") @db.Text

  // --- Fase 3: datos de emergencia ---
  emergencyContactName         String? @map("emergency_contact_name") @db.Text
  emergencyContactPhone        String? @map("emergency_contact_phone") @db.Text
  emergencyContactRelationship String? @map("emergency_contact_relationship") @db.Text
  /// Los 8 grupos mas "No sé". Ojo: "No sé" es un valor legitimo, no un NULL.
  bloodType    String? @map("blood_type") @db.Text
  medicalNotes String? @map("medical_notes") @db.Text

  /// Las dos derivadas —has_tax_id y is_profile_complete— NO son columnas de esta
  /// tabla. Viven en la vista personal.vw_worker, porque Prisma no sabe
  /// representar columnas GENERATED: declararlas produce un diff que intenta
  /// SET/DROP DEFAULT sobre una columna generada, y eso Postgres lo rechaza —
  /// o sea que rompia toda migracion futura. La vista consigue lo mismo (la
  /// derivacion vive en la base, no puede desincronizarse) sin el drift.

  // --- el semaforo: 12 estados ---
  statusLightStateId String @map("status_light_state_id") @db.Uuid
  /// Sostiene la FK compuesta que impide tomar un estado de otro semaforo.
  /// Sin ella, CAFE del Onboarding seria un estado valido de persona.
  statusLightCode String @map("status_light_code") @db.Text

  /// Borrado LOGICO siempre. Blacklist.md es explicito: el colaborador no se
  /// elimina, no aparece en busquedas activas, y el historial se conserva
  /// integro. El deleted_at es lo que permite las tres cosas a la vez.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid

  account         User?            @relation("workerAccount", fields: [userId], references: [id], onDelete: Restrict)
  createdByUser   User             @relation("workerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  catalogPosition CatalogPosition? @relation(fields: [catalogPositionId], references: [id], onDelete: Restrict)
  englishLevel    EnglishLevel?    @relation(fields: [englishLevelId], references: [id], onDelete: Restrict)
  hiringModality  HiringModality?  @relation(fields: [hiringModalityId], references: [id], onDelete: Restrict)
  statusState     StatusLightState @relation("workerState", fields: [statusLightStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)

  documents      WorkerDocument[]
  stateHistory   WorkerStateHistory[]
  assignments    Assignment[]
  blacklistEntries BlacklistEntry[]

  @@id([id])
  /// El Pool filtra por estado, y siempre sobre los no borrados.
  @@index([statusLightStateId], map: "ix_worker_state")
  @@index([zoneId], map: "ix_worker_zone")
  @@index([catalogPositionId], map: "ix_worker_position")
  @@map("worker")
  @@schema("personal")
}

/// El expediente. La Reclutadora "valida documentos": aqui queda constancia de
/// que valido y cuando.
model WorkerDocument {
  id           String  @db.Uuid
  workerId     String  @map("worker_id") @db.Uuid
  /// Lista tecnica: va como CHECK, no como catalogo. El unico que el formulario
  /// pide hoy es el documento de SSN/ITIN, opcional y de maximo 10 MB.
  documentType String  @map("document_type") @db.Text
  filePath     String  @map("file_path") @db.Text
  verifiedBy   String? @map("verified_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  verifierUser User? @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([workerId], map: "ix_worker_document_worker")
  @@map("worker_document")
  @@schema("personal")
}

/// El timeline inmutable de los 12 estados. D-14 aplicado.
///
/// Es la unica forma de responder "cuantos dias llevaba en Cafe" o "quien lo
/// mando a Rosa". Y es lo que lee el servicio para resolver las transiciones de
/// destino variable: Morado -> estado previo y Cafe -> estado previo.
///
/// Append-only: sin updated_at y sin deleted_at, a proposito. Una fila con
/// updated_at significaria que alguien puede cambiar lo que ya ocurrio.
model WorkerStateHistory {
  id       String  @db.Uuid
  workerId String  @map("worker_id") @db.Uuid
  /// NULO en el primer renglon: el colaborador nace en Blanco, sin origen.
  fromStateId String? @map("from_state_id") @db.Uuid
  toStateId   String  @map("to_state_id") @db.Uuid
  statusLightCode String @map("status_light_code") @db.Text
  reasonId    String? @map("reason_id") @db.Uuid
  /// NULO cuando lo movio el sistema: la progresion por dias y el ponche no
  /// tienen persona detras.
  userId     String?  @map("user_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  worker    Worker              @relation(fields: [workerId], references: [id], onDelete: Restrict)
  fromState StatusLightState?   @relation("workerHistFrom", fields: [fromStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  toState   StatusLightState    @relation("workerHistTo", fields: [toStateId, statusLightCode], references: [id, statusLightCode], onDelete: Restrict)
  reason    StatusChangeReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  user      User?               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([workerId, occurredAt(sort: Desc)], map: "ix_worker_state_history_worker")
  @@map("worker_state_history")
  @@schema("personal")
}

// ============================================================================
// coverage — que esta haciendo
// ============================================================================

/// El Colaborador ocupando un slot.
///
/// RR-05 NO se hace cumplir aqui. Se preciso el 2026-08-12 que el colaborador SI
/// puede estar en dos hoteles el mismo dia si son horas distintas, y validity es
/// un daterange: solo ve DIAS. La restriccion de exclusion por HORAS vive en
/// operations, sobre el turno del dia, con un tstzrange que tiene fecha Y hora
/// reales — asi sale gratis el turno nocturno, que cruza medianoche.
///
/// Lo que la base SI impide hoy es que dos colaboradores tomen el mismo slot.
model Assignment {
  id       String @db.Uuid
  slotId   String @map("slot_id") @db.Uuid
  workerId String @map("worker_id") @db.Uuid
  /// Lista cerrada y tecnica: text + CHECK.
  type String @db.Text
  /// El rango de dias. El TEMPORAL lleva fin —el vault dice que se define la
  /// duracion al asignar y que el estado se cierra solo al vencer—; el FIJO no,
  /// porque termina cuando el hotel manda al colaborador a descansar (Rosa).
  validity   Unsupported("daterange")
  status     String  @default("active") @db.Text
  assignedBy String  @map("assigned_by") @db.Uuid
  closedReason String? @map("closed_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  slot           Slot   @relation(fields: [slotId], references: [id], onDelete: Restrict)
  worker         Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  assignedByUser User   @relation(fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([workerId], map: "ix_assignment_worker")
  @@index([slotId], map: "ix_assignment_slot")
  @@map("assignment")
  @@schema("coverage")
}

/// El Self-Pick — RR-15. Varias reclutadoras sobre la misma requisicion.
///
/// Por esto los reclutadores NO estan en la cabecera de la requisicion: son
/// VARIOS a la vez y no hay dueno unico. Ojo: esta tabla habla de la Reclutadora,
/// no del Colaborador.
model Participation {
  id            String    @db.Uuid
  requisitionId String    @map("requisition_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(6)

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([id])
  @@index([requisitionId], map: "ix_participation_requisition")
  @@index([userId], map: "ix_participation_user")
  @@map("participation")
  @@schema("coverage")
}

/// El veto, con su evidencia.
///
/// Por que no basta el estado Negro del semaforo: Blacklist.md exige MOTIVO Y
/// EVIDENCIA, y la evidencia es un ARCHIVO que no cabe en un reason_id de
/// catalogo.
///
/// Negro es PERMANENTE — no hay rehabilitacion ni apelacion. Eso no se programa:
/// simplemente no se siembra ninguna transicion que salga de Negro, y el servicio
/// devuelve 409 porque la transicion no existe.
/// El veto, con su evidencia — y su historial.
///
/// Por que no basta el estado Negro del semaforo: Blacklist.md exige MOTIVO Y
/// EVIDENCIA, y la evidencia es un ARCHIVO que no cabe en un reason_id de
/// catalogo.
///
/// Negro DEJO DE SER PERMANENTE el 2026-08-13, por decision del usuario. Antes el
/// documento decia "no existe proceso de rehabilitacion ni instancia de
/// apelacion", y sobre eso se habia disenado worker_id como UNIQUE simple. Ahora
/// los perfiles de administrador pueden levantar el veto y el colaborador regresa
/// a Blanco, asi que esta tabla es HISTORIAL: la misma persona puede entrar,
/// salir y volver a entrar.
model BlacklistEntry {
  id       String @db.Uuid
  workerId String @map("worker_id") @db.Uuid
  /// Los TRES caminos que lista Blacklist.md: manual (falta grave), absences
  /// (3 inasistencias, automatico) y dispute (el Inspector resolvio a favor del
  /// hotel). Es lo que decide cuando exigir evidencia.
  source String @db.Text
  reason String @db.Text
  /// Obligatorio solo en el manual: el automatico y el de disputa no traen
  /// archivo, su respaldo es el historial.
  evidencePath String? @map("evidence_path") @db.Text
  enteredBy    String  @map("entered_by") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// El levantamiento. Los tres van juntos o no van: levantar un veto es la
  /// accion que mas necesita quedar atribuida, asi que un CHECK lo obliga.
  liftedAt   DateTime? @map("lifted_at") @db.Timestamptz(6)
  liftedBy   String?   @map("lifted_by") @db.Uuid
  liftReason String?   @map("lift_reason") @db.Text

  worker        Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  enteredByUser User   @relation("blacklistEnteredBy", fields: [enteredBy], references: [id], onDelete: Restrict)
  liftedByUser  User?  @relation("blacklistLiftedBy", fields: [liftedBy], references: [id], onDelete: Restrict)

  /// El unico que impide DOS vetos vigentes a la vez es PARCIAL
  /// (WHERE lifted_at IS NULL) y vive fuera del datamodel: Prisma no sabe
  /// declarar indices parciales. Se llama ux_blacklist_active.
  @@id([id])
  @@index([workerId, occurredAt(sort: Desc)], map: "ix_blacklist_worker")
  @@map("blacklist_entry")
  @@schema("coverage")
}

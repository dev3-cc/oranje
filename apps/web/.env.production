# PRODUCCIÓN (oranje-prod). Se usa con `vite build --mode production` en el CI.
#
# SÍ se commitea: la config web de Firebase es PÚBLICA por diseño —igual que la
# key de Maps (D-17)—; se protege con los dominios autorizados en la consola de
# Firebase, no por secreto. Aquí no vive ningún secreto real.

# El front vive en Firebase Hosting (oranje-prod.web.app) y llama al API por su
# URL de Cloud Run: origen distinto, así que el API debe listar los dominios del
# hosting en CORS_ORIGINS.
#
# El servicio de producción AÚN NO está desplegado: esta es la URL determinista
# de Cloud Run (servicio-númeroDeProyecto.región.run.app). Verificarla contra la
# real en el primer despliegue del API.
VITE_API_URL=https://oranje-api-407623682109.us-central1.run.app/api/v1

VITE_USE_MOCKS=false

# Firebase Auth — proyecto Oranje Producción (oranje-prod).
VITE_FIREBASE_API_KEY=AIzaSyCyBC4vM4mhbKltZrLghg_ZqvG65JC4wjU
VITE_FIREBASE_AUTH_DOMAIN=oranje-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=oranje-prod

{
  "extends": "../../packages/config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@oranje/contracts": ["../../packages/contracts/src/index.ts"],
      "@oranje/domain": ["../../packages/domain/src/index.ts"],
      "@oranje/ui": ["../../packages/ui/src/index.ts"],
      /* Alias interno de @oranje/ui: se consume por fuente, así que sus propios
         imports tienen que resolver también desde aquí. No se usa en código de
         esta app — para eso está `@oranje/ui`. */
      "@ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}

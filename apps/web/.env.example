# Backend. En dev apunta al Nest local; en staging/prod lo resuelve el Load Balancer.
VITE_API_URL=http://localhost:3000/api/v1

# Resuelve las peticiones con fixtures locales en vez de llamar a la API.
# Temporal: los endpoints de Ventas todavía no existen en apps/api. Al apagarlo,
# el front pega contra VITE_API_URL sin cambiar una sola línea de componente.
VITE_USE_MOCKS=true

# Firebase Auth — autoridad de identidad (D-05). Los permisos NO viven aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Maps JavaScript API. Pública por diseño (D-17): se restringe por referrer HTTP
# en la consola de GCP. No es un secreto y no va a Secret Manager.
VITE_GOOGLE_MAPS_API_KEY=

# Estándares de Desarrollo §9: este archivo SÍ se commitea; .env NO.
# Toda variable se valida con Zod al arranque. Si falta una, la app no levanta.

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# Un esquema de Postgres por módulo de D-01 (identity, commercial, demand, coverage,
# operations, settlement, supervision, journal, notifications, catalogs)
#
# La base NO es local: vive en Cloud SQL y se llega por el Cloud SQL Auth Proxy,
# que la expone en localhost:5433 (Estándares de BD §13). Ver docs/base-de-datos.md.
# El puerto es 5433 y no 5432 para no chocar con un Postgres instalado en tu máquina.
#
#   pnpm db:proxy        deja esto corriendo en otra terminal
#
# La contraseña de oranje_dev NO va aquí: pídela y ponla en tu apps/api/.env.
DATABASE_URL=postgresql://oranje_dev:CONTRASENA@localhost:5433/oranje?schema=public

# Conexiones por instancia del API. max × instancias <= max_connections de Cloud SQL
DATABASE_POOL_MAX=10
# Espera por un lugar del pool antes de fallar
DATABASE_CONNECT_TIMEOUT_MS=10000
# Techo de una consulta suelta, para que ninguna se quede colgada ocupando el pool
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Identidad ---
# El proveedor depende de la decisión pendiente de nube (A/B en el Plan de Implementación).
# Firebase Auth con GCP (D-05) o Cognito con AWS.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# --- Almacenamiento de archivos (fotos del ponche, documentos) ---
STORAGE_BUCKET=

# --- Observabilidad (D-07) ---
LOG_LEVEL=debug

# Estándares de Desarrollo §9: este archivo SÍ se commitea; .env NO.
# Toda variable se valida con Zod al arranque. Si falta una, la app no levanta.

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# DOS conexiones, a proposito (RR-16 y el principio de menor privilegio):
#
#   DATABASE_URL          -> app_user. La aplicacion. Solo DML: ni DDL, ni
#                            UPDATE/DELETE sobre journal.journal
#   MIGRATE_DATABASE_URL  -> oranje_dev. Dueno de esquemas y tablas. Solo lo usan
#                            `prisma migrate` y el seed
#
# Con el Cloud SQL Auth Proxy el host es localhost:5433, no la IP de la instancia.
DATABASE_URL=postgresql://app_user:CONTRASENA@localhost:5433/oranje?schema=public
MIGRATE_DATABASE_URL=postgresql://oranje_dev:CONTRASENA@localhost:5433/oranje?schema=public

# El pool se configura aquí, no en la URL: Prisma 7 usa un driver adapter.
# max × instancias <= max_connections de Cloud SQL
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Firebase: el login ---
# Firebase Auth es la autoridad de identidad (D-05). Estas dos validan el ID
# token que el cliente manda a POST /api/v1/auth/session.
#
#   local  -> emulador: http://localhost:9099 y el project-id que uses
#   nube   -> https://securetoken.google.com/<project-id>
#
# OJO: contra el emulador los tokens NO se verifican. Solo es seguro en localhost.
AUTH_ISSUER_URL=http://localhost:9099
AUTH_AUDIENCE=oranje-dev

# --- Nuestro JWT: el que protege los CRUD ---
# Firebase dice QUIÉN eres; este token dice QUÉ PUEDES HACER, y es el que exige
# cada endpoint. En producción el secreto sale de Secret Manager (D-07).
JWT_SECRET=                        # mínimo 32 caracteres
JWT_ACCESS_TTL_S=900               # 15 min (Estándares §6)
JWT_REFRESH_TTL_S=604800           # 7 días
COOKIE_SECURE=true                 # false SOLO en local, que no tiene HTTPS

# --- Almacenamiento de archivos (fotos del ponche, documentos) ---
STORAGE_BUCKET=oranje-dev-files

# --- Observabilidad (D-07) ---
LOG_LEVEL=debug

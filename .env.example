# Estándares de Desarrollo §9: este archivo SÍ se commitea; .env NO.
# Toda variable se valida con Zod al arranque. Si falta una, la app no levanta.

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# DOS conexiones, a proposito (RR-16 y el principio de menor privilegio):
#
#   DATABASE_URL          -> app_user. La aplicacion. Solo DML: ni DDL, ni
#                            UPDATE/DELETE sobre journal.journal
#   MIGRATE_DATABASE_URL  -> oranje_dev. Dueno de esquemas y tablas. Solo lo usan
#                            `prisma migrate` y el seed
#
# Con el Cloud SQL Auth Proxy el host es localhost:5433, no la IP de la instancia.
DATABASE_URL=postgresql://app_user:CONTRASENA@localhost:5433/oranje?schema=public
MIGRATE_DATABASE_URL=postgresql://oranje_dev:CONTRASENA@localhost:5433/oranje?schema=public
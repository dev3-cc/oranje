# Estándares de Desarrollo §9: este archivo SÍ se commitea; .env NO.
# Toda variable se valida con Zod al arranque. Si falta una, la app no levanta.
#
# ---------------------------------------------------------------------------
# APP_ENV es el interruptor de ambiente, y NO es NODE_ENV
# ---------------------------------------------------------------------------
# Jest pone NODE_ENV=test por su cuenta. Si de eso dependieran las llaves de
# firma, correr los tests exigiría material criptográfico. Son dos cosas
# distintas: NODE_ENV es de Node, APP_ENV es nuestro.
#
#   local        tu máquina
#   staging      oranje-staging  (rama `staging`)
#   production   oranje-prod     (rama `main`)
#
# Lo que cambia entre ambientes está marcado abajo con [local] y [desplegado].
# Un despliegue mal configurado NO arranca: la validación lo tumba en el
# arranque en vez de dejar la API abierta.
APP_ENV=local
NODE_ENV=development
PORT=3000

# --- Base de datos ---
# DOS conexiones, a proposito (RR-16 y el principio de menor privilegio):
#
#   DATABASE_URL          -> app_user. La aplicacion. Solo DML: ni DDL, ni
#                            UPDATE/DELETE sobre journal.journal
#   MIGRATE_DATABASE_URL  -> oranje_dev. Dueno de esquemas y tablas. Solo lo usan
#                            `prisma migrate` y el seed
#
# Con el Cloud SQL Auth Proxy el host es localhost:5433, no la IP de la instancia.
DATABASE_URL=postgresql://app_user:CONTRASENA@localhost:5433/oranje?schema=public
MIGRATE_DATABASE_URL=postgresql://oranje_dev:CONTRASENA@localhost:5433/oranje?schema=public

# El pool se configura aquí, no en la URL: Prisma 7 usa un driver adapter.
# max × instancias <= max_connections de Cloud SQL
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Firebase: el login ---
# Firebase Auth es la autoridad de identidad (D-05). Estas dos validan el ID
# token que el cliente manda a POST /api/v1/auth/session.
#
#   [local]      emulador: http://localhost:9099 — los tokens NO se verifican
#   [desplegado] https://securetoken.google.com/<project-id>
#
# Apuntar a localhost fuera de local hace fallar el arranque a propósito.
AUTH_ISSUER_URL=http://localhost:9099
AUTH_AUDIENCE=oranje-dev

# --- Apagar la autenticación [SOLO local] ---
# Con esto todo request entra como AUTH_DEV_USER_EMAIL, sin token. Sirve para
# desarrollar CRUD sin montar Firebase.
#
# En staging o producción la app NO ARRANCA si esto viene en true.
AUTH_DISABLED=false
AUTH_DEV_USER_EMAIL=

# --- Nuestro JWT: el que protege los CRUD ---
# Firebase dice QUIÉN eres; este token dice QUÉ PUEDES HACER.
#
#   [local]      HS256 con secreto compartido. Basta y evita repartir llaves
#   [desplegado] RS256 con par de llaves: la privada solo existe donde se emiten
#                tokens, y quien verifica necesita únicamente la pública. Con
#                HS256 el que verifica puede firmar
#
# Genera el par con:  pnpm -F @oranje/api auth:keys
# Cada ambiente lleva SU par: con llave compartida, un token de staging valdría
# en producción. La privada vive en Secret Manager (D-07), nunca en el repo.
JWT_SECRET=                        # [local] mínimo 32 caracteres
JWT_PRIVATE_KEY=                   # [desplegado] PEM PKCS8, saltos como \n
JWT_PUBLIC_KEY=                    # [desplegado] PEM SPKI, saltos como \n

JWT_ACCESS_TTL_S=900               # 15 min (Estándares §6)
JWT_REFRESH_TTL_S=604800           # 7 días

# [desplegado] obligatorio true: la cookie del refresh viaja por HTTPS
COOKIE_SECURE=false

# Lista blanca de orígenes, separados por coma (§6).
#   [local]      se ignora: se abre, porque el front corre en otro puerto
#   [desplegado] obligatoria; sin ella la app no arranca
CORS_ORIGINS=

# Peticiones por minuto y por IP. En local estorba, así que va alto.
RATE_LIMIT_PER_MINUTE=1000

# --- Almacenamiento de archivos (fotos del ponche, documentos) ---
STORAGE_BUCKET=oranje-dev-files

# --- Observabilidad (D-07) ---
LOG_LEVEL=debug

{
  "name": "oranje",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:proxy": "cloud-sql-proxy oranjeapp-gcp:us-central1:oranje --port 5433",
    "db:generate": "pnpm -F @oranje/api exec prisma generate",
    "db:migrate": "pnpm -F @oranje/api exec prisma migrate dev",
    "db:deploy": "pnpm -F @oranje/api exec prisma migrate deploy",
    "db:status": "pnpm -F @oranje/api exec prisma migrate status",
    "db:studio": "pnpm -F @oranje/api exec prisma studio"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@oranje/config": "workspace:*",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
